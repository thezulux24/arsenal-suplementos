# URL pública del CMS (WebProAI / Latinovation CMS)
NEXT_PUBLIC_CMS_URL=https://webproai.tech
# Proyecto del CMS
NEXT_PUBLIC_CMS_SLUG=tusplatos
# URL pública de la tienda (SEO, sitemap; debe estar en productionUrl o en los dominios del proyecto para el regreso de la pasarela)
NEXT_PUBLIC_SITE_URL=https://tusplatos.webproai.tech
# Orígenes extra del portal que pueden embeber la tienda (coma). En producción basta el CMS.
NEXT_PUBLIC_PORTAL_ORIGINS=http://localhost:3005
# Secreto del webhook de publicación (Project.webhookSecret) para /api/revalidate
CMS_WEBHOOK_SECRET=
